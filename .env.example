CAPTION_STUDIO_HOST=0.0.0.0
CAPTION_STUDIO_PORT=8788
CAPTION_STUDIO_WORKSPACE=/data/workspace
CAPTION_STUDIO_MAX_UPLOAD_BYTES=4294967296

# macOS: auto chooses mlx-whisper. Docker defaults to faster-whisper.
CAPTION_ASR_PROVIDER=auto
CAPTION_ASR_DEVICE=cpu
CAPTION_ASR_COMPUTE_TYPE=int8
CAPTION_ASR_DOWNLOAD_ROOT=/data/models
CAPTION_ASR_BEAM_SIZE=5

# OpenAI-compatible translation service. "local" is a label, not a secret.
CAPTION_TRANSLATION_BASE_URL=http://host.docker.internal:8000/v1
CAPTION_TRANSLATION_API_KEY=local
CAPTION_TRANSLATION_MODEL=
CAPTION_TRANSLATION_TIMEOUT=180
